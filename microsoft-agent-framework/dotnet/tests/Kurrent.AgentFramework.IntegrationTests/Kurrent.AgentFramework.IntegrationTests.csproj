<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);CA1822;CA2255;TUnit0055</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="$(MafDotnetSrcDir)Kurrent.AgentFramework/Kurrent.AgentFramework.csproj" />
        <PackageReference Include="TUnit" Version="1.44.0" />
        <PackageReference Include="Testcontainers.KurrentDb" Version="4.11.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
    </ItemGroup>
</Project>
