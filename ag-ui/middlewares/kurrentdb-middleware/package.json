{
  "name": "@kurrent-io/ag-ui-middleware-kurrentdb",
  "version": "0.0.1",
  "description": "AG-UI Protocol middleware that persists agent sessions to KurrentDB as canonical events (DEV-1558)",
  "license": "Apache-2.0",
  "author": "Kurrent, Inc.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
