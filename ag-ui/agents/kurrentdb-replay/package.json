{
  "name": "@kurrent-io/ag-ui-agent-kurrentdb-replay",
  "version": "0.0.1",
  "description": "AG-UI AbstractAgent that replays canonical KurrentDB sessions as AG-UI events (DEV-1559)",
  "license": "Apache-2.0",
  "author": "Kurrent, Inc.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
