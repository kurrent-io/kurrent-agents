  "devDependencies": {
    "@kurrent-io/ag-ui-middleware-kurrentdb": "file:../../middlewares/kurrentdb-middleware",
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
